{
  "regions": ["sin1"],
  "builds": [
    { "src": "api/webhook.py", "use": "@vercel/python" },
    { "src": "api/set_webhook.py", "use": "@vercel/python" },
    { "src": "api/cron/daily.py", "use": "@vercel/python" }
  ],
  "routes": [
    { "src": "/api/webhook", "dest": "api/webhook.py" },
    { "src": "/api/set_webhook", "dest": "api/set_webhook.py" },
    { "src": "/api/cron/daily", "dest": "api/cron/daily.py" }
  ],
  "crons": [
    { "path": "/api/cron/daily", "schedule": "0 0 * * *" }
  ]
}
